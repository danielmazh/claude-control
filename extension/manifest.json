{
  "manifest_version": 3,
  "name": "Claude Control",
  "version": "1.0.1",
  "key": "",
  "description": "Quick actions for your local Claude Control dashboard — launch sessions, check quotas, expand to the full page.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "host_permissions": ["http://127.0.0.1:7799/*"]
}
